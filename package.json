{
  "name": "nnn-games-website",
  "version": "1.0.0",
  "description": "TripleN Games Inc. Website",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "http-server . -p 8080 -c-1 -o",
    "serve": "http-server . -p 8080 -c-1",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./css/style.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./css/style.css --watch",
    "update:metrics": "node scripts/update-metrics.js",
    "build:all": "npm run update:metrics && npm run build:css",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:i18n": "node scripts/check-i18n.js",
    "check:links": "node scripts/check-links.js",
    "check:data": "node scripts/check-data.js",
    "check": "npm run check:i18n && npm run check:links && npm run check:data && npm run lint",
    "test": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnn-games/nnn-games-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nnn-games/nnn-games-website/issues"
  },
  "homepage": "https://github.com/nnn-games/nnn-games-website#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19"
  }
}
