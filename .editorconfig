# 기존 파일의 줄 끝(CRLF/LF)이 섞여 있어 end_of_line 은 지정하지 않는다.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[scripts/**.js]
indent_size = 2

[*.config.js]
indent_size = 2

[*.{json,md,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
